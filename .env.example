# Переменные экспортируйте в оболочке; .env не загружается автоматически.
ACADEMY_ADDR=127.0.0.1:8380
ACADEMY_DB=.data/academy.db
ACADEMY_RUNNER_SOCKET=.data/runner.sock
ACADEMY_WEB=web/dist
# AI-провайдер не требуется. Public bind запрещён.
# Optional Tutor: endpoint is a full OpenAI-compatible chat/completions URL.
# No requests are made without configuration AND explicit browser consent.
# ACADEMY_AI_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
# ACADEMY_AI_MODEL=your-installed-local-model
# ACADEMY_AI_ADVANCED_MODEL=your-installed-local-model
# ACADEMY_AI_FALLBACK_MODEL=your-installed-local-model
# ACADEMY_AI_KEY= # export privately; never commit a real key
# ACADEMY_AI_ALLOW_CLOUD=false # HTTPS public providers require explicit true
# Explicitly describe where your configured provider processes requests; this is never inferred from URL scheme.
# ACADEMY_AI_PROVIDER_LOCATION=unknown # local | cloud | unknown
# Optional path for a server-side cloud provider API key entered in Tutor settings; stored with mode 0600.
# ACADEMY_TUTOR_CLOUD_PROVIDER_CONFIG=.data/tutor-cloud-provider.json
ACADEMY_AI_DAILY_TOKENS=100000
ACADEMY_AI_MAX_OUTPUT_TOKENS=512
# Local credential signing key. Back up privately with the DB; never commit.
# ACADEMY_ISSUER_KEY=.data/issuer.key
# Optional offline human project review registry. Must be operator-owned, mode 0600,
# and contain only trusted Ed25519 public keys; no registry means review is disabled.
# ACADEMY_PROJECT_REVIEWERS_FILE=.data/project-reviewers.json
